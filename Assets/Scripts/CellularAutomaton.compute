#pragma kernel Init
#pragma kernel Step
#pragma kernel PlayerClear
#pragma kernel PlayerDraw
#pragma kernel GunImpact
#pragma kernel GunStep
#pragma kernel EnemyDraw
#pragma kernel EnemyClear
#pragma kernel EnemyImpact
#pragma kernel ScanForGuns
#pragma kernel ClearGunCells
#pragma kernel ClearPositions

RWTexture2D<float4> Result;
Texture2D<float4> Current;

int Width;
int Height;

int BirthMask;
int SurvivalMask;
int CurrentGunBirthMask;
int CurrentGunSurvivalMask;

int Decay;
int CurrentGunDecay;
int DecayCountUp;

int GunCALifespan;

float4 AutomatonID;
float4 CurrentGunAutomatonID;

int2 GunImpactCenter;
int GunImpactRadius;
int GunStepCount;
int GunActive;

uint RandomSeed;

RWTexture2D<float4> World;
StructuredBuffer<int2> PlayerOffsets;
StructuredBuffer<int> PlayerAlive;
int PlayerOffsetCount;
int2 PlayerOrigin;
int2 PlayerPrevOrigin;
float4 PlayerColor;
float4 VitalColor;
int VitalOffsetIndex;
int PlayerRedistributeEnabled;
float PlayerRedistributeFactor;

// ------------------------------------------------------------------
// Helpers
// ------------------------------------------------------------------
float Random01(uint2 p)
{
    uint n = p.x + p.y * 374761393u + RandomSeed * 668265263u;
    n = (n ^ (n >> 13)) * 1274126177u;
    n = n ^ (n >> 16);
    return (n & 0x00FFFFFF) / 16777215.0;
}

bool IsMainCASolid(float4 cell)
{
    float state = cell.a;
    if (Decay > 1) return state > 0.5 && state < Decay - 0.5;
    return state > 0.5 && state < 1.5;
}

bool IsGunCA(float4 cell) { return cell.a >= 20.0 && cell.a < 30.0; }
bool IsGunCAAlive(float4 cell) { return cell.a >= 20.0 && cell.a < 21.0; }
bool IsAnyCASolid(float4 cell) { return IsMainCASolid(cell) || IsGunCA(cell); }

float GetSpan() { return max(1.0, (Decay > 1 ? (float)Decay : 1.0) - 1.0); }

float GetAliveFade()
{
    if (Decay <= 1) return 1.0;
    if (DecayCountUp != 0) return max(0.1, (1.0 / GetSpan()) * 0.5);
    return 1.0;
}

float GetDecayFade(float state)
{
    float span = GetSpan();
    if (DecayCountUp != 0) return (state - 1.0) / span;
    return 1.0 - (state - 1.0) / span;
}

// ------------------------------------------------------------------
// Init
// ------------------------------------------------------------------
[numthreads(8, 8, 1)]
void Init(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= Width || id.y >= Height) return;

    float random = Random01(id.xy);
    float deadState = (Decay > 1) ? (float)Decay : 0.0;
    float aliveFade = GetAliveFade();

    if (random > 0.95)
        Result[id.xy] = float4(AutomatonID.rgb * aliveFade, 1.0);
    else
        Result[id.xy] = float4(0, 0, 0, deadState);
}

// ------------------------------------------------------------------
// Main CA Step
// ------------------------------------------------------------------
[numthreads(8, 8, 1)]
void Step(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= Width || id.y >= Height) return;

    int2 pos = int2(id.xy);
    float state = Current[pos].a;
    bool isGunCell = IsGunCA(Current[pos]);
    float deadState = (Decay > 1) ? (float)Decay : 0.0;
    bool decayEnabled = Decay > 1;
    float aliveFade = GetAliveFade();

    bool isDecaying = !isGunCell && decayEnabled && state > 1.5 && state < deadState - 0.5;

    if (isDecaying)
    {
        float newState = state + 1.0;
        if (newState >= deadState - 0.5)
            Result[pos] = float4(0, 0, 0, deadState);
        else
            Result[pos] = float4(AutomatonID.rgb * GetDecayFade(newState), newState);
        return;
    }

    bool isAlive = !isGunCell && state > 0.5 && state < 1.5;

    int neighbours = 0;
    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            if (x == 0 && y == 0) continue;
            int2 p = pos + int2(x, y);
            p.x = (p.x + Width) % Width;
            p.y = (p.y + Height) % Height;
            if (!IsGunCA(Current[p]) && Current[p].a > 0.5 && Current[p].a < 1.5)
                neighbours++;
        }
    }

    bool born = (BirthMask & (1 << neighbours)) != 0;
    bool survives = (SurvivalMask & (1 << neighbours)) != 0;

    if (isAlive && survives)
    {
        Result[pos] = float4(AutomatonID.rgb * aliveFade, 1.0);
        return;
    }

    if (isAlive && decayEnabled && 2.0 < deadState - 0.5)
    {
        Result[pos] = float4(AutomatonID.rgb * GetDecayFade(2.0), 2.0);
        return;
    }

    Result[pos] = born ? float4(AutomatonID.rgb * aliveFade, 1.0) : (isGunCell ? Current[pos] : float4(0, 0, 0, deadState));
}

// ------------------------------------------------------------------
// Gun Impact
// ------------------------------------------------------------------
[numthreads(8, 8, 1)]
void GunImpact(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= Width || id.y >= Height) return;
    int2 pos = int2(id.xy);

    if (distance(float2(pos), float2(GunImpactCenter)) <= GunImpactRadius)
    {
        float4 current = Current[pos];
        if (IsMainCASolid(current) || IsGunCA(current))
            Result[pos] = float4(CurrentGunAutomatonID.rgb, 20.0);
        else
            Result[pos] = current;
    }
    else
    {
        Result[pos] = Current[pos];
    }
}

// ------------------------------------------------------------------
// Gun CA Step
// ------------------------------------------------------------------
[numthreads(8, 8, 1)]
void GunStep(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= Width || id.y >= Height) return;
    int2 pos = int2(id.xy);
    float state = Current[pos].a;

    bool isGunCell = (state >= 20.0 && state < 30.0);
    bool isNearGun = false;

    if (!isGunCell)
    {
        for (int y = -1; y <= 1; y++)
        {
            for (int x = -1; x <= 1; x++)
            {
                if (x == 0 && y == 0) continue;
                int2 p = pos + int2(x, y);
                p.x = (p.x + Width) % Width;
                p.y = (p.y + Height) % Height;
                if (IsGunCA(Current[p])) { isNearGun = true; break; }
            }
            if (isNearGun) break;
        }
    }

    if (!isGunCell && !isNearGun)
    {
        Result[pos] = Current[pos];
        return;
    }

    // Decaying gun CA
    if (isGunCell && state >= 21.0 && state < 30.0)
    {
        float gunDecayState = 20.0 + (float)CurrentGunDecay;
        if (CurrentGunDecay > 1)
        {
            float newState = state + 1.0;
            if (newState >= gunDecayState)
                Result[pos] = float4(0, 0, 0, 0);
            else
            {
                float fade = 1.0 - (newState - 20.0) / max(1.0, gunDecayState - 20.0);
                Result[pos] = float4(CurrentGunAutomatonID.rgb * fade, newState);
            }
        }
        else
        {
            Result[pos] = float4(0, 0, 0, 0);
        }
        return;
    }

    int gunNeighbours = 0;
    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            if (x == 0 && y == 0) continue;
            int2 p = pos + int2(x, y);
            p.x = (p.x + Width) % Width;
            p.y = (p.y + Height) % Height;
            if (Current[p].a >= 20.0 && Current[p].a < 21.0) gunNeighbours++;
        }
    }

    bool isGunAlive = (state >= 20.0 && state < 21.0);
    bool gunSurvives = (CurrentGunSurvivalMask & (1 << gunNeighbours)) != 0;
    bool gunBorn = (CurrentGunBirthMask & (1 << gunNeighbours)) != 0;

    if (isGunAlive && gunSurvives)
        Result[pos] = float4(CurrentGunAutomatonID.rgb, 20.0);
    else if (isGunAlive && CurrentGunDecay > 1)
    {
        float gunDecayState = 20.0 + (float)CurrentGunDecay;
        float fade = 1.0 / max(1.0, gunDecayState - 20.0);
        Result[pos] = float4(CurrentGunAutomatonID.rgb * fade, 21.0);
    }
    else if (isGunAlive)
        Result[pos] = float4(0, 0, 0, 0);
    else if (gunBorn && !IsMainCASolid(Current[pos]))
        Result[pos] = float4(CurrentGunAutomatonID.rgb, 20.0);
    else
        Result[pos] = Current[pos];
}

// ------------------------------------------------------------------
// Player Clear
// ------------------------------------------------------------------
[numthreads(64, 1, 1)]
void PlayerClear(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= PlayerOffsetCount) return;

    int2 offset = PlayerOffsets[id.x];
    if (PlayerRedistributeEnabled != 0 && VitalOffsetIndex >= 0 && VitalOffsetIndex < PlayerOffsetCount)
    {
        int2 vitalOff = PlayerOffsets[VitalOffsetIndex];
        float2 rel = float2(offset - vitalOff);
        float2 newRel = rel * PlayerRedistributeFactor;
        offset = vitalOff + int2(round(newRel));
    }

    int2 pos = PlayerPrevOrigin + offset;
    if (pos.x < 0 || pos.x >= Width || pos.y < 0 || pos.y >= Height) return;

    float4 existing = World[pos];
    if (!IsAnyCASolid(existing))
        World[pos] = float4(0, 0, 0, existing.a);
}

// ------------------------------------------------------------------
// Player Draw
// ------------------------------------------------------------------
[numthreads(64, 1, 1)]
void PlayerDraw(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= PlayerOffsetCount) return;
    if (PlayerAlive[id.x] == 0) return;

    int2 offset = PlayerOffsets[id.x];
    if (PlayerRedistributeEnabled != 0 && VitalOffsetIndex >= 0 && VitalOffsetIndex < PlayerOffsetCount)
    {
        int2 vitalOff = PlayerOffsets[VitalOffsetIndex];
        float2 rel = float2(offset - vitalOff);
        float2 newRel = rel * PlayerRedistributeFactor;
        offset = vitalOff + int2(round(newRel));
    }

    int2 pos = PlayerOrigin + offset;
    if (pos.x < 0 || pos.x >= Width || pos.y < 0 || pos.y >= Height) return;

    float4 existing = World[pos];
    if (!IsAnyCASolid(existing))
    {
        float3 color = ((int)id.x == VitalOffsetIndex) ? VitalColor.rgb : PlayerColor.rgb;
        World[pos] = float4(color, existing.a);
    }
}

// Enemy buffers and uniforms
StructuredBuffer<int2> EnemyOffsets;
StructuredBuffer<int> EnemyAlive;
int EnemyOffsetCount;
int2 EnemyOrigin;
int2 EnemyPrevOrigin;
float4 EnemyColor;
float4 EnemyVitalColor;
int EnemyVitalOffsetIndex;
int EnemyVitalHit;      // 1 if enemy vital was within radius, else 0

// ------------------------------------------------------------------
// Enemy Draw
// ------------------------------------------------------------------
[numthreads(64, 1, 1)]
void EnemyDraw(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= EnemyOffsetCount) return;
    if (EnemyAlive[id.x] == 0) return;

    int2 offset = EnemyOffsets[id.x];
    int2 pos = EnemyOrigin + offset;
    if (pos.x < 0 || pos.x >= Width || pos.y < 0 || pos.y >= Height) return;

    float4 existing = World[pos];
    // Draw over any cell (including solid main CA) but preserve alpha
    float3 color = ((int)id.x == EnemyVitalOffsetIndex) ? EnemyVitalColor.rgb : EnemyColor.rgb;
    World[pos] = float4(color, existing.a);
}

// ------------------------------------------------------------------
// Enemy Clear
// ------------------------------------------------------------------
[numthreads(64, 1, 1)]
void EnemyClear(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= EnemyOffsetCount) return;

    int2 offset = EnemyOffsets[id.x];
    int2 pos = EnemyPrevOrigin + offset;
    if (pos.x < 0 || pos.x >= Width || pos.y < 0 || pos.y >= Height) return;

    float4 existing = World[pos];
    // Restore original color (black) but keep the alpha (CA state)
    World[pos] = float4(0, 0, 0, existing.a);
}

// ------------------------------------------------------------------
// Enemy Impact (called when a gun shot hits this enemy)
// ------------------------------------------------------------------
[numthreads(64, 1, 1)]
void EnemyImpact(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= EnemyOffsetCount) return;
    if (EnemyAlive[id.x] == 0) return;

    int2 offset = EnemyOffsets[id.x];
    int2 pos = EnemyOrigin + offset;
    if (pos.x < 0 || pos.x >= Width || pos.y < 0 || pos.y >= Height) return;

    float dist = distance(float2(pos), float2(GunImpactCenter));
    if (dist <= GunImpactRadius)
    {
        // Convert to gun CA
        World[pos] = float4(CurrentGunAutomatonID.rgb, 20.0);
    }
    else if (EnemyVitalHit == 1)
    {
        // Vital was hit, convert remaining cells to main CA
        World[pos] = float4(AutomatonID.rgb, 1.0);
    }
}

StructuredBuffer<int2> PositionsToClear;
int ClearCount;
[numthreads(64, 1, 1)]
void ClearPositions(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= ClearCount) return;
    int2 pos = PositionsToClear[id.x];
    if (pos.x < 0 || pos.x >= Width || pos.y < 0 || pos.y >= Height) return;
    float deadState = (Decay > 1) ? (float)Decay : 0.0;
    World[pos] = float4(0, 0, 0, deadState);
}

// Gun scanning uniforms
Texture2D<float4> TemplateTexture;
int TemplateWidth;
int TemplateHeight;
int ScanStride;
float MatchThreshold;

// Output buffers for matches
struct MatchResult
{
    int2 center;
    int cellCount;
    int minX;
    int maxX;
    int minY;
    int maxY;
};

RWStructuredBuffer<MatchResult> MatchResults;
RWStructuredBuffer<int> MatchCount;
RWStructuredBuffer<int2> GunCellsToClear;

// Maximum matches and cells to clear
#define MAX_MATCHES 256
#define MAX_CELLS_TO_CLEAR 4096

// ------------------------------------------------------------------
// CheckTemplateMatch - Checks overlap with template (NO ROTATION)
// ------------------------------------------------------------------
float CheckTemplateMatch(int startX, int startY)
{
    float total = 0;
    float matched = 0;
    
    for (int y = 0; y < TemplateHeight; y++)
    {
        for (int x = 0; x < TemplateWidth; x++)
        {
            float4 templatePixel = TemplateTexture[int2(x, y)];
            bool templateSolid = templatePixel.r > 0.5f;
            if (!templateSolid) continue;
            
            total++;
            
            int2 worldPos = int2(startX + x, startY + y);
            if (worldPos.x >= 0 && worldPos.x < Width && 
                worldPos.y >= 0 && worldPos.y < Height)
            {
                float4 cell = World[worldPos];
                if (IsMainCASolid(cell))
                {
                    matched++;
                }
            }
        }
    }
    
    return total > 0 ? matched / total : 0;
}

// ------------------------------------------------------------------
// ScanForGuns Kernel - Finds gun shapes in the CA
// ------------------------------------------------------------------
[numthreads(8, 8, 1)]
void ScanForGuns(uint3 id : SV_DispatchThreadID)
{
    int startX = id.x * ScanStride;
    int startY = id.y * ScanStride;
    
    // Bounds check
    if (startX + TemplateWidth >= Width || startY + TemplateHeight >= Height) return;
    
    // Quick pre-check: count solid cells in the area
    int solidCount = 0;
    for (int y = 0; y < TemplateHeight && solidCount < 3; y++)
    {
        for (int x = 0; x < TemplateWidth && solidCount < 3; x++)
        {
            float4 templatePixel = TemplateTexture[int2(x, y)];
            if (templatePixel.r > 0.5f)
            {
                int2 worldPos = int2(startX + x, startY + y);
                float4 cell = World[worldPos];
                if (IsMainCASolid(cell))
                {
                    solidCount++;
                }
            }
        }
    }
    
    if (solidCount < 2) return;
    
    // Full match check (only original orientation - no rotation)
    float match = CheckTemplateMatch(startX, startY);
    
    if (match >= MatchThreshold)
    {
        int idx;
        InterlockedAdd(MatchCount[0], 1, idx);
        
        if (idx < MAX_MATCHES)
        {
            MatchResult result;
            int2 center = int2(startX + TemplateWidth/2, startY + TemplateHeight/2);
            result.center = center;
            
            // Store the template area as the bounds
            result.minX = startX;
            result.maxX = startX + TemplateWidth;
            result.minY = startY;
            result.maxY = startY + TemplateHeight;
            
            // Count cells in the template area
            result.cellCount = 0;
            for (int y = startY; y < startY + TemplateHeight; y++)
            {
                for (int x = startX; x < startX + TemplateWidth; x++)
                {
                    float4 cell = World[int2(x, y)];
                    if (IsMainCASolid(cell))
                        result.cellCount++;
                }
            }
            
            MatchResults[idx] = result;
        }
    }
}

// ------------------------------------------------------------------
// ClearGunCells - Removes gun cells from the CA
// ------------------------------------------------------------------
[numthreads(64, 1, 1)]
void ClearGunCells(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= MatchCount[0]) return;
    
    MatchResult match = MatchResults[id.x];
    int2 center = match.center;
    
    // Clear all cells in the bounding box
    for (int y = match.minY; y <= match.maxY; y++)
    {
        for (int x = match.minX; x <= match.maxX; x++)
        {
            int2 pos = int2(x, y);
            if (pos.x >= 0 && pos.x < Width && pos.y >= 0 && pos.y < Height)
            {
                float4 cell = World[pos];
                if (IsMainCASolid(cell) || IsGunCA(cell))
                {
                    // Clear the cell
                    float deadState = (Decay > 1) ? (float)Decay : 0.0;
                    World[pos] = float4(0, 0, 0, deadState);
                }
            }
        }
    }
}

// ------------------------------------------------------------------
// CountConnectedComponent - BFS to count cells in the gun
// ------------------------------------------------------------------
int CountConnectedComponent(int2 startPos)
{
    // Use a simple stack-based flood fill
    // Since we're in a compute shader, we'll use a fixed-size array
    int2 stack[1024];
    int stackSize = 0;
    int count = 0;
    
    // Check if start position is solid
    float4 startCell = World[startPos];
    if (!IsMainCASolid(startCell) && !IsGunCA(startCell)) return 0;
    
    stack[stackSize++] = startPos;
    
    int radius = max(TemplateWidth, TemplateHeight) * 2;
    int count2 = 0;
    
    for (int y = -radius; y <= radius; y++)
    {
        for (int x = -radius; x <= radius; x++)
        {
            int2 pos = startPos + int2(x, y);
            if (pos.x >= 0 && pos.x < Width && pos.y >= 0 && pos.y < Height)
            {
                float4 cell = World[pos];
                if (IsMainCASolid(cell) || IsGunCA(cell))
                {
                    // Check if connected (using a simpler check - within the template area)
                    if (abs(x) < TemplateWidth * 2 && abs(y) < TemplateHeight * 2)
                    {
                        count2++;
                    }
                }
            }
        }
    }
    
    return count2;
}

// ------------------------------------------------------------------
// CalculateBoundingBox - Finds the extents of the gun shape
// ------------------------------------------------------------------
void CalculateBoundingBox(int2 center, out int minX, out int maxX, out int minY, out int maxY)
{
    minX = Width;
    maxX = 0;
    minY = Height;
    maxY = 0;
    
    int radius = max(TemplateWidth, TemplateHeight) * 2;
    
    for (int y = -radius; y <= radius; y++)
    {
        for (int x = -radius; x <= radius; x++)
        {
            int2 pos = center + int2(x, y);
            if (pos.x >= 0 && pos.x < Width && pos.y >= 0 && pos.y < Height)
            {
                float4 cell = World[pos];
                if (IsMainCASolid(cell) || IsGunCA(cell))
                {
                    if (pos.x < minX) minX = pos.x;
                    if (pos.x > maxX) maxX = pos.x;
                    if (pos.y < minY) minY = pos.y;
                    if (pos.y > maxY) maxY = pos.y;
                }
            }
        }
    }
}

int2 GetRotatedPos(int x, int y, int rotation, int startX, int startY)
{
    // Center of template
    int cx = TemplateWidth / 2;
    int cy = TemplateHeight / 2;
    
    // Translate to center
    int tx = x - cx;
    int ty = y - cy;
    
    int rx = tx, ry = ty;
    
    // Rotate
    if (rotation == 1) { rx = -ty; ry = tx; }      // 90°
    else if (rotation == 2) { rx = -tx; ry = -ty; } // 180°
    else if (rotation == 3) { rx = ty; ry = -tx; }  // 270°
    
    // Translate back and add offset
    return int2(startX + cx + rx, startY + cy + ry);
}