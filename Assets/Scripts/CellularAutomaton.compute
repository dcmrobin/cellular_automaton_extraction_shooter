#pragma kernel Init
#pragma kernel Step

RWTexture2D<float4> Result;
Texture2D<float4> Current;

int Width;
int Height;

int BirthMask;
int SurvivalMask;

int Decay;
int DecayCountUp;

float4 AutomatonID;

uint RandomSeed;

float Random01(uint2 p)
{
    uint n = p.x + p.y * 374761393u + RandomSeed * 668265263u;
    n = (n ^ (n >> 13)) * 1274126177u;
    n = n ^ (n >> 16);

    return (n & 0x00FFFFFF) / 16777215.0;
}


[numthreads(8, 8, 1)]
void Init(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= Width || id.y >= Height)
        return;

    float random = Random01(id.xy);

    float deadState = (Decay > 1) ? (float)Decay : 0.0;

    if (random > 0.5)
        Result[id.xy] = float4(AutomatonID.rgb, 1.0);
    else
        Result[id.xy] = float4(0, 0, 0, deadState);
}


[numthreads(8, 8, 1)]
void Step(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= Width || id.y >= Height)
        return;

    int2 pos = int2(id.xy);
    float state = Current[pos].a;

    // Decay > 1:
    //   1            = alive
    //   2 .. Decay-1 = decaying (ignores neighbours, fades)
    //   Decay        = dead (checked for rebirth every tick)
    // Decay <= 1: classic Life, 0 = dead, 1 = alive, no decay stage.
    bool decayEnabled = Decay > 1;
    float deadState = decayEnabled ? (float)Decay : 0.0;

    bool isDecaying = decayEnabled && state > 1.5 && state < deadState - 0.5;

    if (isDecaying)
    {
        float newState = state + 1.0;
        float span = max(1.0, deadState - 1.0);
        float fade = DecayCountUp ? (newState - 1.0) / span : 1.0 - (newState - 1.0) / span;

        Result[pos] = float4(AutomatonID.rgb * fade, newState);
        return; // decaying cells never look at neighbours
    }

    bool isAlive = state > 0.5 && state < 1.5;

    int neighbours = 0;
    for (int y = -1; y <= 1; y++)
        for (int x = -1; x <= 1; x++)
        {
            if (x == 0 && y == 0) continue;

            int2 p = pos + int2(x, y);
            p.x = (p.x + Width) % Width;
            p.y = (p.y + Height) % Height;

            float nState = Current[p].a;
            if (nState > 0.5 && nState < 1.5) // only exactly-alive counts
                neighbours++;
        }

    bool born = (BirthMask & (1 << neighbours)) != 0;
    bool survives = (SurvivalMask & (1 << neighbours)) != 0;

    if (isAlive && survives)
    {
        Result[pos] = float4(AutomatonID.rgb, 1.0);
        return;
    }

    if (isAlive && decayEnabled && 2.0 < deadState - 0.5)
    {
        // Fails survival, enters the first decay frame.
        float span = max(1.0, deadState - 1.0);
        float fade = DecayCountUp ? (1.0 / span) : (1.0 - 1.0 / span);
        Result[pos] = float4(AutomatonID.rgb * fade, 2.0);
        return;
    }

    // Dead: was already dead, decay just finished, Decay <= 2 with no room
    // to decay, or Decay <= 1 (classic instant-death Life). All paths
    // re-check neighbours for rebirth on this same tick.
    Result[pos] = born ? float4(AutomatonID.rgb, 1.0) : float4(0, 0, 0, deadState);
}