#pragma kernel Init
#pragma kernel Step

RWTexture2D<float4> Result;
Texture2D<float4> Current;

int Width;
int Height;

int BirthMask;
int SurvivalMask;

int Decay;

float4 AutomatonID;

uint RandomSeed;

float Random01(uint2 p)
{
    uint n = p.x + p.y * 374761393u + RandomSeed * 668265263u;
    n = (n ^ (n >> 13)) * 1274126177u;
    n = n ^ (n >> 16);

    return (n & 0x00FFFFFF) / 16777215.0;
}


[numthreads(8, 8, 1)]
void Init(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= Width || id.y >= Height)
        return;

    float random = Random01(id.xy);

    if (random > 0.5)
    {
        Result[id.xy] = float4(AutomatonID.rgb, 1.0);
    }
    else
    {
        Result[id.xy] = float4(0, 0, 0, 0);
    }
}


[numthreads(8, 8, 1)]
void Step(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= Width || id.y >= Height)
        return;

    int2 pos = int2(id.xy);

    float4 cell = Current[pos];

    int neighbours = 0;

    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            if (x == 0 && y == 0)
                continue;

            int2 p = pos + int2(x, y);

            p.x = (p.x + Width) % Width;
            p.y = (p.y + Height) % Height;

            if (Current[p].a > 0.5)
                neighbours++;
        }
    }

    bool born = (BirthMask & (1 << neighbours)) != 0;
    bool survives = (SurvivalMask & (1 << neighbours)) != 0;

    if (cell.a > 0.5)
    {
        if (survives)
            Result[pos] = float4(cell.rgb, 1.0);
        else
            Result[pos] = float4(0, 0, 0, 0);
    }
    else
    {
        if (born)
            Result[pos] = float4(AutomatonID.rgb, 1.0);
        else
        {
            if (Decay <= 1)
            {
                Result[pos] = float4(0, 0, 0, 0);
            }
            else
            {
                float newAlpha = cell.a - (1.0 / (float)Decay);

                if (newAlpha <= 0.0)
                {
                    Result[pos] = float4(0, 0, 0, 0);
                }
                else
                {
                    Result[pos] = float4(cell.rgb, newAlpha);
                }
            }
        }
    }
}